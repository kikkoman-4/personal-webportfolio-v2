---
import BaseLayout from "@layouts/BaseLayout.astro";
import HudFrame from "@components/HudFrame.astro";
import Navbar from "@components/Navbar.astro";
import Hero from "@components/Hero.astro";
import AboutSection from "@components/AboutSection.astro";
import TerminalSection from "@components/TerminalSection.astro";
import ProjectsSection from "@components/ProjectsSection.astro";
import ExperienceSection from "@components/ExperienceSection.astro";
import SkillsSection from "@components/SkillsSection.astro";
import Footer from "@components/Footer.astro";
import SlideControls from "@components/SlideControls.astro";
---

<BaseLayout
  title="AA KIKZ AFABLE | Full-Stack Developer & Software Engineer"
  description="Full-Stack Developer based in BGC, Taguig, Philippines specializing in modern web applications, 60 FPS Canvas engines, and AI workflows."
>
  <!-- Cybernetic HUD Framing -->
  <HudFrame />

  <div class="deck-wrapper">
    <!-- Persistent Top Navigation Bar -->
    <Navbar
      brandName="KIKZ AFABLE"
      role="FULL-STACK & CREATIVE SOFTWARE ENGINEER"
      location="BGC, PHILIPPINES"
    />

    <!-- PowerPoint-Style Presentation Slides Viewport -->
    <main id="main-content" class="slides-viewport" aria-label="Portfolio Presentation Deck">
      <div class="slides-stage" id="slides-stage">
        <!-- Slide 01: Hero / Wireframe Engine Core -->
        <article
          class="slide-panel active"
          data-slide="0"
          data-anchor="home"
          data-title="01 // WIREFRAME ENGINE CORE"
          id="slide-home"
          aria-label="Slide 1 of 9: Home"
        >
          <div class="slide-inner">
            <Hero />
          </div>
        </article>

        <!-- Slide 02: About / Dossier & Verified Telemetry -->
        <article
          class="slide-panel"
          data-slide="1"
          data-anchor="about"
          data-title="02 // SYSTEM DOSSIER & BIO"
          id="slide-about"
          aria-label="Slide 2 of 9: About Me"
        >
          <div class="slide-inner">
            <AboutSection />
          </div>
        </article>

        <!-- Slide 03: Command Interface / Terminal Console -->
        <article
          class="slide-panel"
          data-slide="2"
          data-anchor="terminal"
          data-title="03 // COMMAND INTERFACE"
          id="slide-terminal"
          aria-label="Slide 3 of 9: Terminal Console"
        >
          <div class="slide-inner">
            <TerminalSection />
          </div>
        </article>

        <!-- Slide 04: Works / Web & Cloud Platforms -->
        <article
          class="slide-panel"
          data-slide="3"
          data-anchor="projects"
          data-title="04 // WORKS: WEB & CLOUD"
          id="slide-projects"
          aria-label="Slide 4 of 9: Web & Cloud Projects"
        >
          <div class="slide-inner">
            <ProjectsSection group="platforms" tagNumber="04" />
          </div>
        </article>

        <!-- Slide 05: Works / Engines & Realtime Systems -->
        <article
          class="slide-panel"
          data-slide="4"
          data-anchor="works-engines"
          data-title="05 // WORKS: ENGINES & REALTIME"
          id="slide-engines"
          aria-label="Slide 5 of 9: Creative Engines & Multiplayer"
        >
          <div class="slide-inner">
            <ProjectsSection group="engines" tagNumber="05" />
          </div>
        </article>

        <!-- Slide 06: Experience / Career Timeline -->
        <article
          class="slide-panel"
          data-slide="5"
          data-anchor="experience"
          data-title="06 // CAREER TIMELINE"
          id="slide-experience"
          aria-label="Slide 6 of 9: Professional Experience"
        >
          <div class="slide-inner">
            <ExperienceSection view="engineering" tagNumber="06" />
          </div>
        </article>

        <!-- Slide 07: Experience / Leadership & Academics -->
        <article
          class="slide-panel"
          data-slide="6"
          data-anchor="leadership"
          data-title="07 // LEADERSHIP & ACADEMICS"
          id="slide-leadership"
          aria-label="Slide 7 of 9: Leadership & Academic Honors"
        >
          <div class="slide-inner">
            <ExperienceSection view="leadership" tagNumber="07" />
          </div>
        </article>

        <!-- Slide 08: Skills / Technical Arsenal -->
        <article
          class="slide-panel"
          data-slide="7"
          data-anchor="skills"
          data-title="08 // TECHNICAL ARSENAL"
          id="slide-skills"
          aria-label="Slide 8 of 9: Technical Skills"
        >
          <div class="slide-inner">
            <SkillsSection />
          </div>
        </article>

        <!-- Slide 09: Contact / Direct Transmission -->
        <article
          class="slide-panel"
          data-slide="8"
          data-anchor="contact"
          data-title="09 // DIRECT TRANSMISSION"
          id="slide-contact"
          aria-label="Slide 9 of 9: Direct Transmission"
        >
          <div class="slide-inner">
            <Footer
              brand="KIKZ AFABLE"
              year="2026"
              location="PHILIPPINES  UTC+8"
              email="kikzafable@gmail.com"
              github="https://github.com/Kikkoman-4"
            />
          </div>
        </article>
      </div>

      <!-- Slide Deck HUD Navigation & Indicator Controls -->
      <SlideControls total={9} />
    </main>
  </div>
</BaseLayout>

<script>
  import { initSlideDeck } from "@scripts/slides";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSlideDeck);
  } else {
    initSlideDeck();
  }
</script>

<style>
  :global(html.slide-deck-mode),
  :global(body.slide-deck-mode) {
    height: 100%;
    margin: 0;
    overflow: hidden;
  }

  .deck-wrapper {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }

  /* Presentation Viewport */
  .slides-viewport {
    flex: 1;
    position: relative;
    width: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .slides-stage {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* Slide Presentation Panels - Solid Opaque Surfaces */
  .slide-panel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    will-change: transform;
    opacity: 1 !important;
    background: var(--color-bg);
  }

  /* Inner viewport - Force fit to screen */
  .slide-inner {
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(0.5rem, 1.5vh, 1.5rem) clamp(0.75rem, 2.5vw, 2rem) calc(var(--hud-inset) + clamp(3.2rem, 5.5vh, 4.5rem));
    box-sizing: border-box;
  }

  /* Fallback scrollability only for ultra-short viewports */
  @media (max-height: 560px) {
    .slide-inner {
      overflow-y: auto;
      justify-content: flex-start;
      -webkit-overflow-scrolling: touch;
    }
  }

  /* Component layout adjustments inside presentation slides */
  .slide-panel :global(.hero-section),
  .slide-panel :global(.about-section),
  .slide-panel :global(.terminal-section),
  .slide-panel :global(.projects-section),
  .slide-panel :global(.experience-section),
  .slide-panel :global(.skills-section),
  .slide-panel :global(.site-footer) {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex-shrink: 0;
  }
</style>
