---
// Navbar.astro - Top tech navigation and live status sub-header
interface Props {
  brandName?: string;
  role?: string;
  location?: string;
}

const {
  brandName = "KIKZ CREATES",
  role = "FULL-STACK DEVELOPER & SOFTWARE ENGINEER",
  location = "BGC, PHILIPPINES",
} = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <!-- Brand / Logo -->
    <a href="#" class="brand">
      <span class="brand-glyph" aria-hidden="true">&#x7b;&amp;&#x7d;</span>
      <span class="brand-text">{brandName}</span>
    </a>

    <!-- Nav Links -->
    <nav class="nav-links" aria-label="Main Navigation">
      <a href="#home" class="nav-item active">
        <span class="nav-dot" aria-hidden="true">•</span> Home
      </a>
      <a href="#about" class="nav-item">Dossier</a>
      <a href="#terminal" class="nav-item">Console</a>
      <a href="#projects" class="nav-item">Works</a>
      <a href="#experience" class="nav-item">Timeline</a>
      <a href="#skills" class="nav-item">Skills</a>
      <a href="#contact" class="nav-item">Contact</a>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <button
        type="button"
        class="icon-dial-btn"
        aria-label="Toggle procedural HUD audio feedback"
        title="Toggle audio feedback"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor">
          <circle cx="12" cy="12" r="9" stroke-width="1.2" stroke-dasharray="2 3" opacity="0.7"></circle>
          <circle cx="12" cy="12" r="3" fill="currentColor" opacity="0.8"></circle>
        </svg>
      </button>

      <a href="#contact" class="pill-cta">
        <span>Let's talk</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <!-- Sub-header Meta Status Bar -->
  <div class="sub-status-bar">
    <div class="status-left">
      <span class="status-indicator">
        <span class="status-dot"></span>
        <span class="mono-hud">AVAILABLE FOR PROJECTS</span>
      </span>
      <span class="mono-hud separator">/</span>
      <span class="mono-hud role-text">{role}</span>
    </div>

    <div class="status-right">
      <span class="mono-hud location-text">{location}</span>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--hud-inset) + 0.75rem) 1.5rem 0.5rem;
    position: relative;
    z-index: 30;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Brand */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--color-text-main);
  }

  .brand-glyph {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text-main);
    opacity: 0.9;
  }

  .brand-text {
    text-transform: uppercase;
  }

  /* Navigation Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-item {
    font-size: 0.84rem;
    color: var(--color-text-muted);
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color var(--transition-fast);
  }

  .nav-item:hover,
  .nav-item.active {
    color: var(--color-text-main);
  }

  .nav-item.active .nav-dot {
    color: var(--color-accent-red);
  }

  .nav-dot {
    color: var(--color-text-hud);
    font-size: 1rem;
    line-height: 0;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .icon-dial-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .icon-dial-btn:hover {
    color: var(--color-text-main);
    border-color: var(--color-border-hover);
    background: var(--color-bg-subtle);
  }

  .icon-dial-btn.sound-on {
    color: var(--color-accent-green);
    border-color: rgba(34, 197, 94, 0.4);
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.2);
  }

  .pill-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.48rem 1.15rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-border-pill);
    color: var(--color-text-main);
    font-size: 0.82rem;
    font-weight: 500;
    backdrop-filter: blur(8px);
    transition: all var(--transition-fast);
  }

  .pill-cta:hover {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
    box-shadow: 0 0 16px rgba(255, 255, 255, 0.2);
  }

  .pill-cta .arrow {
    font-size: 0.9rem;
    line-height: 1;
    transition: transform var(--transition-fast);
  }

  .pill-cta:hover .arrow {
    transform: translate(2px, -2px);
  }

  /* Sub-header status bar */
  .sub-status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    padding-bottom: 0.5rem;
  }

  .status-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-indicator .mono-hud {
    color: var(--color-text-sub);
  }

  .separator {
    color: var(--color-text-hud);
  }

  .role-text {
    color: var(--color-text-muted);
  }

  .location-text {
    color: var(--color-text-muted);
  }

  /* Mobile responsiveness */
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .separator, .role-text {
      display: none;
    }
  }
</style>

<script>
  import { initAudio } from "@scripts/audio";
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAudio);
  } else {
    initAudio();
  }
</script>

