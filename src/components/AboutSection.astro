---
// AboutSection.astro - Operative System Dossier & Live Telemetry
const verifiedMetrics = [
  { value: "+40%", label: "INBOUND CLIENT LEADS", sub: "HildrStudios Main Storefront" },
  { value: "60+ FPS", label: "ZERO-DEPENDENCY ENGINE", sub: "Olympus Dash Arcade Jam" },
  { value: "200+", label: "WEEKLY CIVIC REQUESTS", sub: "LGU Central Portal" },
  { value: "0%", label: "SYSTEM DOWNTIME", sub: "Dockerized Python Architecture" },
];

const credentials = [
  { label: "DEGREE", val: "BS in Computer Science (Dean's Lister)" },
  { label: "LEADERSHIP", val: "President @ Shiba Re-Ignite Org" },
  { label: "SECURITY", val: "Google Network Security Certified" },
  { label: "AI WORKFLOWS", val: "Google AI Specialization Certified" },
];
---

<section id="about" class="about-section">
  <div class="section-container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="header-left">
        <span class="section-tag mono-hud">
          <span class="hud-slash">//</span> 02. SYSTEM DOSSIER &amp; BIO
        </span>
        <h2 class="section-title">Engineering background &amp; philosophy.</h2>
      </div>
      <div class="header-right">
        <span class="mono-hud status-online">
          <span class="status-dot"></span> DOSSIER VERIFIED // LEVEL_01
        </span>
      </div>
    </div>

    <!-- Bento Grid Structure for System Dossier -->
    <div class="about-bento">
      <!-- Row 1: Narrative Philosophy + Live Station Telemetry -->
      <div class="bento-row two-cols">
        <!-- Card 1: Bio & Approach -->
        <div class="bento-card card-narrative glass-panel">
          <div class="card-bar mono-hud">
            <span class="id-badge">OPERATIVE: AA KIKZ H. AFABLE</span>
            <span class="sub-badge">BGC_STATION</span>
          </div>

          <h3 class="narrative-heading">
            Bridging high-performance interfaces with resilient cloud architectures.
          </h3>

          <p class="narrative-p">
            Computer Science graduate based in BGC, Taguig, specializing in full-stack development, AI workflows, and high-performance interactive architectures. Focused on speed, reliability, and measurable client impact.
          </p>

          <!-- Verified Credentials Grid -->
          <div class="creds-list mono-hud">
            {
              credentials.map((c) => (
                <div class="cred-row">
                  <span class="cred-k">{c.label}:</span>
                  <span class="cred-v">{c.val}</span>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Card 2: Live Station Telemetry -->
        <div class="bento-card card-telemetry glass-panel">
          <div class="card-bar mono-hud">
            <span>STATION_TELEMETRY</span>
            <span class="text-green">[LIVE_FEED]</span>
          </div>

          <div class="time-widget">
            <div class="time-display" id="about-clock">--:--:--</div>
            <div class="tz-label mono-hud">PHT // UTC+8 • PHILIPPINE STANDARD TIME</div>
          </div>

          <div class="telemetry-rows mono-hud">
            <div class="tele-row">
              <span class="k">LOCATION:</span>
              <span class="v">BGC, Taguig (14.55° N, 121.05° E)</span>
            </div>
            <div class="tele-row">
              <span class="k">STATUS:</span>
              <span class="v text-green">AVAILABLE FOR CONTRACT &amp; FULL-TIME</span>
            </div>
            <div class="tele-row">
              <span class="k">PIPELINE:</span>
              <span class="v">99.9% UPTIME // CI/CD AUTOMATION</span>
            </div>
            <div class="tele-row">
              <span class="k">RESPONSE:</span>
              <span class="v">&lt; 24 HOURS INQUIRY SLA</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Row 2: Verified Performance Benchmarks Full Width -->
      <div class="bento-card card-benchmarks glass-panel">
        <div class="card-bar mono-hud">
          <span>VERIFIED_BENCHMARKS</span>
          <span class="text-hud">// LOGGED IMPACT</span>
        </div>

        <div class="benchmarks-stack">
          {
            verifiedMetrics.map((m) => (
              <div class="benchmark-item">
                <div class="bench-val">{m.value}</div>
                <div class="bench-label mono-hud">{m.label}</div>
                <div class="bench-sub">{m.sub}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(0.5rem, 1.5vh, 1.5rem) clamp(0.75rem, 2vw, 1.5rem);
    position: relative;
    z-index: 10;
  }

  .section-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.5vh, 1.25rem);
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: clamp(0.4rem, 1vh, 0.75rem);
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-tag {
    color: var(--color-text-muted);
    display: block;
    font-size: clamp(0.65rem, 1vw, 0.72rem);
    margin-bottom: 0.25rem;
  }

  .hud-slash {
    color: var(--color-accent-red);
  }

  .section-title {
    font-size: clamp(1.25rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .status-online {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    color: var(--color-text-sub);
  }

  /* Bento Layout */
  .about-bento {
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.5vh, 1.15rem);
  }

  .bento-row {
    display: grid;
    gap: clamp(0.6rem, 1.5vh, 1.15rem);
  }

  .bento-row.two-cols {
    grid-template-columns: 1.25fr 1fr;
  }

  .bento-card {
    padding: clamp(0.75rem, 1.5vh, 1.35rem);
    background: rgba(10, 12, 16, 0.75);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-normal);
  }

  .bento-card:hover {
    border-color: var(--color-border-hover);
  }

  .card-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--color-text-muted);
    padding-bottom: clamp(0.35rem, 0.8vh, 0.65rem);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: clamp(0.5rem, 1vh, 0.85rem);
  }

  .id-badge {
    color: var(--color-text-sub);
  }

  .sub-badge {
    color: var(--color-text-hud);
  }

  /* Narrative */
  .narrative-heading {
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.3;
    margin-bottom: clamp(0.35rem, 0.8vh, 0.65rem);
  }

  .narrative-p {
    font-size: clamp(0.78rem, 1.2vw, 0.88rem);
    line-height: 1.55;
    color: var(--color-text-sub);
    margin-bottom: clamp(0.45rem, 1vh, 0.85rem);
  }

  /* Credentials */
  .creds-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.35rem, 0.8vh, 0.65rem);
    margin-top: clamp(0.35rem, 0.8vh, 0.65rem);
    padding-top: clamp(0.35rem, 0.8vh, 0.65rem);
    border-top: 1px solid var(--color-border-subtle);
  }

  .cred-row {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.68rem;
  }

  .cred-k {
    color: var(--color-text-hud);
    font-size: 0.62rem;
  }

  .cred-v {
    color: #ffffff;
    font-weight: 500;
  }

  /* Telemetry Clock */
  .card-telemetry {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .time-widget {
    margin: clamp(0.35rem, 0.8vh, 0.75rem) 0;
    padding: clamp(0.5rem, 1vh, 0.85rem);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .time-display {
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 3.2vw, 2.2rem);
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.08em;
  }

  .tz-label {
    font-size: 0.62rem;
    color: var(--color-text-sub);
    margin-top: 0.2rem;
  }

  .telemetry-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(0.3rem, 0.7vh, 0.55rem);
    font-size: 0.68rem;
  }

  .tele-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.04);
    padding-bottom: 0.25rem;
  }

  .tele-row .k {
    color: var(--color-text-hud);
  }

  .tele-row .v {
    color: var(--color-text-sub);
    font-weight: 500;
  }

  /* Benchmarks */
  .benchmarks-stack {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.5rem, 1vw, 1.25rem);
  }

  .benchmark-item {
    padding: clamp(0.4rem, 0.8vh, 0.75rem);
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-sm);
  }

  .bench-val {
    font-family: var(--font-mono);
    font-size: clamp(1.15rem, 2.2vw, 1.7rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
  }

  .bench-label {
    font-size: 0.62rem;
    color: var(--color-accent-green);
    margin: 0.2rem 0 0.1rem;
    letter-spacing: 0.04em;
  }

  .bench-sub {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .bento-row.two-cols {
      grid-template-columns: 1fr;
    }

    .benchmarks-stack {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .creds-list {
      grid-template-columns: 1fr;
    }

    .card-telemetry {
      display: none; /* Hide secondary telemetry on ultra-compact mobile to guarantee 100% force fit */
    }

    .benchmarks-stack {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.4rem;
    }
  }
</style>

<script>
  function updateAboutClock() {
    const el = document.getElementById("about-clock");
    if (!el) return;
    const now = new Date();
    const formatter = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Manila",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });
    el.textContent = formatter.format(now);
  }

  updateAboutClock();
  setInterval(updateAboutClock, 1000);
</script>
