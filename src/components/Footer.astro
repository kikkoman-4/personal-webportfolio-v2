---
// Footer.astro - Bottom HUD metadata bar, contact actions, and telemetry links
interface Props {
  brand?: string;
  year?: string;
  location?: string;
  email?: string;
  github?: string;
}

const {
  brand = "KIKZ AFABLE",
  year = "2026",
  location = "PHILIPPINES  UTC+8",
  email = "kikzafable@gmail.com",
  github = "https://github.com/Kikkoman-4",
} = Astro.props;
---

<footer id="contact" class="site-footer">
  <!-- Contact Callout / Direct Reach -->
  <div class="contact-box glass-panel">
    <div class="contact-content">
      <span class="mono-hud contact-tag">
        <span class="status-dot"></span> DIRECT TRANSMISSION
      </span>
      <h2 class="contact-headline">Let's build something remarkable.</h2>
      <p class="contact-sub">
        Available for full-time engineering roles, freelance web applications, and AI integrations.
      </p>

      <div class="contact-channels">
        <button
          type="button"
          class="channel-pill primary"
          id="copy-email-btn"
          data-email={email}
          title="Click to copy email address"
        >
          <span id="copy-email-text">{email}</span>
          <span class="copy-badge" id="copy-status-badge" aria-hidden="true">COPY 📋</span>
        </button>
        <a href={github} target="_blank" rel="noopener noreferrer" class="channel-pill">
          <span>GitHub // Kikkoman-4</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a href="https://kikzafable.vercel.app" target="_blank" rel="noopener noreferrer" class="channel-pill">
          <span>Live MVP Portfolio</span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom HUD Bar -->
  <div class="bottom-hud-bar">
    <div class="hud-left mono-hud">
      <span>{location}</span>
    </div>

    <div class="hud-center" aria-hidden="true">
      <span class="ellipsis-dots">• • •</span>
    </div>

    <div class="hud-right">
      <span class="mono-hud copyright-text">{brand} / {year}</span>

      <button
        type="button"
        class="hud-grid-btn"
        aria-label="Back to top"
        onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
        title="Return to top"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <circle cx="6" cy="6" r="1.5"></circle>
          <circle cx="12" cy="6" r="1.5"></circle>
          <circle cx="18" cy="6" r="1.5"></circle>
          <circle cx="6" cy="12" r="1.5"></circle>
          <circle cx="12" cy="12" r="1.5"></circle>
          <circle cx="18" cy="12" r="1.5"></circle>
          <circle cx="6" cy="18" r="1.5"></circle>
          <circle cx="12" cy="18" r="1.5"></circle>
          <circle cx="18" cy="18" r="1.5"></circle>
        </svg>
      </button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem calc(var(--hud-inset) + 1.5rem);
    position: relative;
    z-index: 30;
  }

  /* Contact Callout Box */
  .contact-box {
    padding: 3rem 2.5rem;
    margin-bottom: 3.5rem;
    background: rgba(14, 16, 22, 0.85);
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .contact-box::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 250px;
    height: 100%;
    background: radial-gradient(circle at 100% 50%, rgba(255, 255, 255, 0.04), transparent 70%);
    pointer-events: none;
  }

  .contact-content {
    max-width: 680px;
  }

  .contact-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--color-text-sub);
  }

  .contact-headline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .contact-sub {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .contact-channels {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .channel-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-pill);
    color: var(--color-text-main);
    font-size: 0.85rem;
    font-family: var(--font-mono);
    transition: all var(--transition-fast);
  }

  .channel-pill.primary {
    background: #ffffff;
    color: #000000;
    font-weight: 600;
    border-color: #ffffff;
  }

  .channel-pill.primary:hover {
    background: #e4e4e7;
    transform: translateY(-2px);
  }

  .channel-pill:not(.primary):hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }

  .channel-pill .arrow {
    transition: transform var(--transition-fast);
  }

  .channel-pill:hover .arrow {
    transform: translate(2px, -2px);
  }

  /* Bottom HUD Bar */
  .bottom-hud-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .hud-left {
    color: var(--color-text-muted);
    letter-spacing: 0.12em;
  }

  .ellipsis-dots {
    color: var(--color-text-hud);
    letter-spacing: 0.3em;
    font-size: 0.9rem;
  }

  .hud-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .copyright-text {
    color: var(--color-text-muted);
  }

  .hud-grid-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .hud-grid-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .contact-box {
      padding: 1.75rem 1.25rem;
    }
    .hud-center {
      display: none;
    }
    .bottom-hud-bar {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
    .hud-right {
      width: 100%;
      justify-content: space-between;
    }
  }

  .copy-badge {
    font-size: 0.65rem;
    padding: 0.15rem 0.45rem;
    background: rgba(0, 0, 0, 0.15);
    border-radius: var(--radius-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    margin-left: 0.25rem;
    transition: all var(--transition-fast);
  }

  #copy-email-btn.copied .copy-badge {
    background: var(--color-accent-green);
    color: #000000;
    font-weight: 700;
  }
</style>

<script>
  function initCopyEmail() {
    const btn = document.getElementById("copy-email-btn");
    const badge = document.getElementById("copy-status-badge");
    if (!btn || !badge) return;

    btn.addEventListener("click", async () => {
      const email = btn.getAttribute("data-email") || "kikzafable@gmail.com";
      try {
        await navigator.clipboard.writeText(email);
        btn.classList.add("copied");
        badge.textContent = "COPIED ✓";
        setTimeout(() => {
          btn.classList.remove("copied");
          badge.textContent = "COPY 📋";
        }, 2200);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCopyEmail);
  } else {
    initCopyEmail();
  }
</script>

